/*
  Security defaults for the static site. Content-Security-Policy is intentionally
  tracked separately until the remaining inline scripts and styles are migrated
  or supplied with nonces; shipping a partial policy would break the lead path.
*/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
